{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "condition_annotation.schema.json",
  "title": "Condition normalization annotation",
  "type": "object",
  "required": ["record_id", "split", "raw_condition", "candidates", "gold"],
  "additionalProperties": false,
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "test"]},
    "raw_condition": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/conceptCandidate"}
    },
    "gold": {
      "oneOf": [
        {
          "type": "object",
          "required": ["no_match", "selected_candidate_id"],
          "additionalProperties": false,
          "properties": {
            "no_match": {"const": false},
            "selected_candidate_id": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["no_match", "selected_candidate_id"],
          "additionalProperties": false,
          "properties": {
            "no_match": {"const": true},
            "selected_candidate_id": {"type": "null"}
          }
        }
      ]
    },
    "adjudication_note": {"type": "string"}
  },
  "$defs": {
    "conceptCandidate": {
      "type": "object",
      "required": ["candidate_id", "concept_id", "preferred_term", "similarity"],
      "additionalProperties": false,
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "concept_id": {"type": "string", "minLength": 1},
        "preferred_term": {"type": "string", "minLength": 1},
        "similarity": {"type": "number", "minimum": -1, "maximum": 1}
      }
    }
  }
}
