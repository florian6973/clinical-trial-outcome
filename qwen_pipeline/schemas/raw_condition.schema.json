{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raw_condition.schema.json",
  "title": "AACT condition prepared for normalization",
  "type": "object",
  "required": ["record_id", "nct_id", "raw_condition"],
  "additionalProperties": false,
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
