{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "condition_normalization_output.schema.json",
  "title": "Condition normalization output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "condition_text",
    "snomed_concept_id",
    "snomed_term",
    "disease_area",
    "similarity",
    "candidate_rank",
    "qwen_model",
    "selection_method",
    "candidates"
  ],
  "properties": {
    "condition_text": {"type": "string", "minLength": 1},
    "snomed_concept_id": {"type": "string", "minLength": 1},
    "snomed_term": {"type": "string", "minLength": 1},
    "disease_area": {"type": "string", "minLength": 1},
    "similarity": {"type": "number", "minimum": -1, "maximum": 1},
    "candidate_rank": {"type": "integer", "minimum": 1},
    "qwen_model": {"const": "Qwen/Qwen2.5-32B-Instruct"},
    "selection_method": {"const": "faiss_candidates_then_qwen_selection"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concept_id", "term", "disease_area", "similarity", "rank"],
        "properties": {
          "concept_id": {"type": "string", "minLength": 1},
          "term": {"type": "string", "minLength": 1},
          "disease_area": {"type": "string", "minLength": 1},
          "similarity": {"type": "number", "minimum": -1, "maximum": 1},
          "rank": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
