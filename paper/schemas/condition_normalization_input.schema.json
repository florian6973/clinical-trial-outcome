{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "condition_normalization_input.schema.json",
  "title": "Condition normalization input",
  "type": "object",
  "additionalProperties": false,
  "required": ["condition_text", "condition_embedding"],
  "properties": {
    "condition_text": {"type": "string", "minLength": 1},
    "condition_embedding": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"},
      "description": "L2-normalized NV-Embed-v2 query vector."
    }
  }
}
